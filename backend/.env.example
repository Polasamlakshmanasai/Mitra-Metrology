# ──────────────────────────────────────────────────────────────
# Mitra Metrology — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_SECRET

# ── Database ──────────────────────────────────────────────────
# SQLite (default for local development — no server needed)
DATABASE_URL=sqlite:///./mitra.db

# MongoDB Atlas (set this for cloud persistence, Stage 6)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# MongoDB database name (defaults to mitra_metrology if not set)
DATABASE_NAME=mitra_metrology

# ── Tesseract OCR ─────────────────────────────────────────────
# Leave empty to use auto-detection (checks common install paths).
# Set explicitly if Tesseract is installed in a non-standard location.
#
# Windows example:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Linux / Docker (usually not needed — /usr/bin/tesseract is auto-detected):
#   TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# ── CORS / Frontend ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * only in development.
ALLOWED_ORIGINS=*

# ── Upload Storage ────────────────────────────────────────────
# Where uploaded images are stored on the server.
# Default is backend/uploads/ (relative to the backend directory).
# UPLOAD_DIR=/var/mitra/uploads

# ── Deployment ────────────────────────────────────────────────
# Port is injected by Render at runtime ($PORT). Set locally if needed.
# PORT=8000
